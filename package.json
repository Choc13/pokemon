{
  "name": "creature-chronicles",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/domain",
    "packages/ports",
    "packages/adapters",
    "packages/content",
    "packages/app"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=packages/domain",
    "lint": "eslint packages/*/src/**/*.ts packages/*/src/**/*.tsx",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx,json}'",
    "dev": "npm run dev --workspace=packages/app"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-functional": "^6.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
